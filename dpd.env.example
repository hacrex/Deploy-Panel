# /etc/deploypanel/dpd.env
# Every setting is documented in docs/CONFIG.md. Values shown are the defaults unless
# a line is commented out as optional.

# Admin UI and API. Keep it on loopback and publish it through the proxy with TLS.
DP_LISTEN=127.0.0.1:8080
# DP_ALLOW_PUBLIC_LISTEN=false
# DP_PUBLIC_URL=https://panel.example.com

# Where node agents connect (mTLS). Loopback is right for a single-node install.
DP_AGENT_LISTEN=127.0.0.1:8443

DP_DB_DRIVER=sqlite
DP_DB_PATH=/var/lib/deploypanel/dpd.db

# Master key for encrypting secrets: mode 0600, at least 32 bytes. Back it up separately.
DP_SECRET_KEY_FILE=/etc/deploypanel/secret.key

# Optional modules, comma separated.
# DP_MODULES=wordpress,dns

DP_LOG_LEVEL=info
DP_LOG_TTL=7d
DP_METRIC_TTL=30d
